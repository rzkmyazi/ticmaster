# ============================================================================
# TIC MASTER — configuration d'exemple (#by_Myazirzk)
# Copier ce fichier en .env puis renseigner les valeurs. NE JAMAIS COMMITER .env
# ============================================================================

# --- Clé de signature des sessions (OBLIGATOIRE en production) --------------
# Générer : python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=changez-moi-par-une-valeur-aleatoire-de-64-caracteres

# --- Environnement ----------------------------------------------------------
FLASK_ENV=production

# --- Base de données --------------------------------------------------------
# Laisser vide pour SQLite locale (instance/ticmaster.db)
# Production Render : postgresql://utilisateur:motdepasse@hote/base
DATABASE_URL=

# --- Cookies / sessions -----------------------------------------------------
# COOKIE_SECURE=1 impose HTTPS : obligatoire en production, 0 en local (http)
COOKIE_SECURE=1
AUTH_SESSION_HOURS=8
AUTH_COOKIE_NAME=tic_auth

# --- Anti force brute -------------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=40
LOGIN_IP_WINDOW_MINUTES=10

# --- Fichiers ---------------------------------------------------------------
MAX_CONTENT_MB=30
UPLOAD_FOLDER=

# --- Présence / divers ------------------------------------------------------
PRESENCE_ONLINE_SECONDS=120
SITE_NAME=TIC MASTER
SUPER_ADMIN_USERNAME=Myazirzk
TIMEZONE_LABEL=UTC

# --- E-mail SMTP (facultatif) ----------------------------------------------
MAIL_ENABLED=0
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ticmaster.local
MAIL_USE_TLS=1
